DATABASE_URL="postgresql://postgres:postgres@localhost:5432/caretext?schema=public"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_PHONE_NUMBER="+15551234567"
TWILIO_API_KEY_SID="SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_API_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_TWIML_APP_SID="APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_CONVERSATIONS_SERVICE_SID="ISxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_MESSAGING_SERVICE_SID="MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_GROUP_PROJECTED_ADDRESS="+15559876543"

# Notify CommStack (server-side only). Required for Notify-client messaging.
# Package: @notify/commstack-sdk from notify-commstack-sdk-1.2.0.tgz
# 'dev' for staging (e.g. qsscommbe3), 'production' for prod host.
# Per-community APP_ID, APP_NAME, BASE_URL, and PORTAL_USER_ID are stored on
# each Notify contact (Contacts / conversation contact details) — not here.
COMM_STACK_ENV="dev"
# Optional: long-lived CommStack Socket.IO in this Node process.
# Default: off on Vercel, on for local `next dev`. Set 0 to force off, 1 to force on.
# COMM_STACK_REALTIME="0"
# Optional: COMM_STACK_TIMEOUT_MS="15000"
# Optional override if Notify ever requires an explicit token:
# COMM_STACK_SDK_TOKEN=...

# Shared secret for Notify Alert/Clear webhooks (header x-notify-webhook-secret or ?token=).
# Required in production; optional in development.
NOTIFY_ALERT_WEBHOOK_SECRET="replace-with-notify-webhook-secret"

# Email (password reset). If unset, reset links are logged to the server console
# instead of emailed (fine for local dev). Port 465 uses implicit TLS; others use STARTTLS.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="apikey"
SMTP_PASSWORD="replace-with-smtp-password"
EMAIL_FROM="CareText <no-reply@example.com>"
