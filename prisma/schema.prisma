generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime queries go through this URL (Prisma Accelerate pooled endpoint in prod).
  url       = env("DATABASE_URL")
  // Migrations / introspection need a direct connection (Accelerate can't run them).
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  admin
  nurse
}

enum ConversationStatus {
  new
  sms_sent
  awaiting_reply
  replied
  escalated
  closed
}

enum MessageDirection {
  inbound
  outbound
}

enum MessageStatus {
  queued
  sent
  delivered
  failed
  received
}

enum MessageType {
  text
  voice
  photo
  pdf
}

enum ConsentStatus {
  none
  opted_in
  opted_out
}

enum ConsentEventType {
  intro_sent
  intro_delivered
  intro_failed
  opted_out
  resubscribed
  group_intro_sent
}

enum ConversationType {
  direct
  group
}

enum AlertType {
  Alert
  Clear
}

enum AlertStatus {
  open
  cleared
  unmatched
}

enum ParticipantStatus {
  pending_intro
  active
  removed
}

enum CallDirection {
  outbound
  inbound
}

enum CallMode {
  browser
  phone
}

enum CallStatus {
  initiating
  ringing
  in_progress
  completed
  failed
  no_answer
  busy
  canceled
}

model User {
  id                    String               @id @default(uuid())
  name                  String
  email                 String               @unique
  passwordHash          String
  role                  UserRole             @default(nurse)
  phoneNumber           String?
  mustChangePassword    Boolean              @default(false)
  disabledAt            DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  assignedConversations Conversation[]       @relation("ConversationAssignee")
  sentMessages          Message[]
  notes                 InternalNote[]
  callLogs              CallLog[]
  consentEvents         ConsentEvent[]
  passwordResetTokens   PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Contact {
  id                       String                    @id @default(uuid())
  name                     String?
  // Exactly one of phone / notifyClientId / notifyChannelId (enforced in app + DB check).
  phone                    String?                   @unique
  notifyClientId           String?                   @unique
  notifyChannelId          String?                   @unique
  facility                 String?
  address                  String?
  notes                    String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  // Per-community CommStack credentials (required for Notify individual or channel).
  commStackAppId           String?
  commStackAppName         String?
  commStackBaseUrl         String?
  commStackPortalUserId    String?
  consentStatus            ConsentStatus             @default(none)
  consentUpdatedAt         DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  deletedAt                DateTime?
  conversations            Conversation[]
  conversationParticipants ConversationParticipant[]
  consentEvents            ConsentEvent[]
  alerts                   Alert[]

  @@index([name])
  @@index([phone])
  @@index([notifyClientId])
  @@index([notifyChannelId])
  @@index([facility])
  @@index([commStackAppId])
  @@index([deletedAt])
}

model Conversation {
  id                     String                    @id @default(uuid())
  type                   ConversationType          @default(direct)
  contactId              String?
  title                  String?
  twilioConversationSid  String?                   @unique
  twilioProjectedAddress String?
  status                 ConversationStatus        @default(new)
  assignedToId           String?
  archivedAt             DateTime?
  lastMessageAt          DateTime                  @default(now())
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  contact                Contact?                  @relation(fields: [contactId], references: [id], onDelete: Restrict)
  assignedTo             User?                     @relation("ConversationAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages               Message[]
  callLogs               CallLog[]
  notes                  InternalNote[]
  participants           ConversationParticipant[]
  alerts                 Alert[]

  @@index([contactId])
  @@index([assignedToId])
  @@index([archivedAt])
  @@index([lastMessageAt])
  // Composite index for the inbox list query
  // (WHERE archivedAt IS NULL ORDER BY lastMessageAt DESC). Without it, Postgres
  // walks the single-column lastMessageAt index and skips over every archived
  // row to find the newest non-archived ones — a scan that grows unbounded as
  // more conversations are archived, eventually pushing the query past the
  // Accelerate query-duration limit. This lets it seek straight to the active
  // rows in lastMessageAt order.
  @@index([archivedAt, lastMessageAt])
  @@index([status])
  @@index([type])
}

model ConversationParticipant {
  id                   String            @id @default(uuid())
  conversationId       String
  contactId            String
  twilioParticipantSid String?
  status               ParticipantStatus @default(pending_intro)
  removedAt            DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  conversation         Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  contact              Contact           @relation(fields: [contactId], references: [id], onDelete: Restrict)

  @@unique([conversationId, contactId])
  @@index([conversationId])
  @@index([contactId])
}

model Message {
  id                    String           @id @default(uuid())
  conversationId        String
  userId                String?
  body                  String
  messageType           MessageType      @default(text)
  durationSeconds       Int?
  direction             MessageDirection
  status                MessageStatus
  twilioSid             String?          @unique
  commStackMessageId    String?          @unique
  errorMessage          String?
  isConsentIntro        Boolean          @default(false)
  authorPhone           String?
  twilioConversationSid String?
  isSystemNote          Boolean          @default(false)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  conversation          Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user                  User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  consentEvents         ConsentEvent[]
  attachment            MessageAttachment?

  @@index([conversationId, createdAt])
  @@index([status])
  // pg_trgm GIN index on `body` for fast ILIKE message-content search. The
  // gin_trgm_ops operator class comes from the pg_trgm extension, which is
  // created in migration 20260715000000_add_message_body_trgm_index.
  @@index([body(ops: raw("gin_trgm_ops"))], type: Gin, map: "message_body_trgm_idx")
}

model MessageAttachment {
  id            String   @id @default(uuid())
  messageId     String   @unique
  bytes         Bytes
  contentType   String
  filename      String
  sizeBytes     Int
  commStackFile String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  message       Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model Alert {
  id             String        @id @default(uuid())
  externalId     String
  type           AlertType
  status         AlertStatus   @default(open)
  eventDateTime  DateTime
  ackDateTime    DateTime?
  facilityCode   String?
  locationName   String?
  locationBuilding String?
  residentFirstName String?
  residentLastName  String?
  deviceName     String?
  deviceType     String?
  payload        Json?
  contactId      String?
  conversationId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  contact        Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@unique([externalId, eventDateTime])
  @@index([status])
  @@index([eventDateTime])
  @@index([contactId])
  @@index([conversationId])
  @@index([facilityCode])
}

model Template {
  id        String   @id @default(uuid())
  title     String
  body      String
  category  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([category])
}

model CallLog {
  id              String        @id @default(uuid())
  conversationId  String?
  phone           String
  initiatedById   String?
  twilioSid       String?
  direction       CallDirection @default(outbound)
  mode            CallMode      @default(browser)
  status          CallStatus    @default(initiating)
  durationSeconds Int?
  recordingSid    String?
  recordingUrl    String?
  startedAt       DateTime      @default(now())
  endedAt         DateTime?
  outcome         String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  conversation    Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  initiatedBy     User?         @relation(fields: [initiatedById], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@index([initiatedById])
  @@index([phone])
  @@index([status])
}

model InternalNote {
  id             String       @id @default(uuid())
  conversationId String
  userId         String
  body           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([userId])
}

model ConsentEvent {
  id        String           @id @default(uuid())
  contactId String
  messageId String?
  userId    String?
  type      ConsentEventType
  twilioSid String?
  detail    String?
  createdAt DateTime         @default(now())
  contact   Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  message   Message?         @relation(fields: [messageId], references: [id], onDelete: SetNull)
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([contactId, createdAt])
  @@index([type])
}
